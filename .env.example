# Airwallex SANDBOX credentials: Account > Developer > API keys. Never commit the real values.
AWX_BASE_URL=https://api.sandbox.airwallex.com
AWX_CLIENT_ID=
AWX_API_KEY=

# Secret used to sign payout approvals and certificates (>= 32 chars). Generate with: openssl rand -hex 32
TESSERA_APPROVAL_SECRET=

# Anthropic (evidence reader). Optional: without it the reader endpoint answers 503 and evidence is entered by hand.
ANTHROPIC_API_KEY=
TESSERA_MODEL=

# Tessera API on localhost. The Next.js server holds the token; browsers never do. Generate with: openssl rand -hex 24
TESSERA_API_TOKEN=
TESSERA_OPERATOR=ops@example.com
# How long a transfer must stay PAID before it can be certified. Production policy is 24h (86400000).
TESSERA_PAID_HOLD_MS=86400000
# Name written on every agent action in the ledger when an MCP client drives Tessera (bun run mcp).
# TESSERA_AGENT_NAME=agent:claude-desktop
# Optional overrides
# TESSERA_API_PORT=4010
# TESSERA_DB=.data/tessera.db
# TESSERA_BENEFICIARY_ID=
