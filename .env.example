# Tessera configuration. `bun run setup` creates .env from this file and fills the two generated secrets.
# `bun run demo` needs none of it: it runs offline on a simulated Airwallex with a scripted agent.

# Airwallex SANDBOX credentials: Account > Developer > API keys. Never commit the real values.
AWX_BASE_URL=https://api.sandbox.airwallex.com
AWX_CLIENT_ID=
AWX_API_KEY=
# Webhook endpoint secret from the Airwallex dashboard. Set it to accept signed events at POST /api/webhooks/airwallex
# (the route answers 404 without it). Webhooks are hints only; the sweep below catches anything they miss.
AWX_WEBHOOK_SECRET=

# Secret used to sign payout approvals and certificates (>= 32 chars). Generated by `bun run setup`, or: openssl rand -hex 32
TESSERA_APPROVAL_SECRET=

# Anthropic: the evidence reader and the console's agent runs. Optional: without them the reader endpoint answers 503
# and evidence is entered by hand (offline, a scripted agent and a keyword reader stand in, labelled "not Claude").
ANTHROPIC_API_KEY=
TESSERA_MODEL=claude-sonnet-5-5

# Tessera API on localhost. The Next.js server holds the token; browsers never do. Generated by `bun run setup`.
TESSERA_API_TOKEN=
TESSERA_OPERATOR=ops@example.com
# How long a transfer must stay PAID before it can be certified, in whole milliseconds. Blank = 24h (86400000).
# Offline the default is 6000 so certification can be shown; `bun run demo` always uses 6000.
TESSERA_PAID_HOLD_MS=86400000
# Background sweep in the API: recover stray intents, then sync every live transfer. 0 disables it.
# TESSERA_SWEEP_MS=60000

# Name written on every agent action in the ledger, for console agent runs (default agent:claude) and MCP clients
# (default agent:mcp). The scripted offline agent is always agent:scripted.
# TESSERA_AGENT_NAME=agent:claude-desktop
# What an MCP client may do: operator (default) or triage (no replace_payment, no reconcile_and_close).
# TESSERA_AGENT_AUTHORITY=operator

# Offline mode: simulated Airwallex in-process, in-memory ledger, no money and no network. 1 to enable.
# TESSERA_OFFLINE=1
# Public demo (only legal with TESSERA_OFFLINE=1): the console accepts requests for the hosts listed below, not just
# loopback. The API itself stays on 127.0.0.1.
# TESSERA_PUBLIC_DEMO=1
# TESSERA_ALLOWED_HOSTS=demo.example.com

# Optional overrides
# TESSERA_API_PORT=4010
# TESSERA_API_URL=http://127.0.0.1:4010
# TESSERA_DB=.data/tessera.db
# Beneficiary for USD invoices; default is the sandbox beneficiary nicknamed spike-us-supplier (`bun run setup`).
# TESSERA_BENEFICIARY_ID=
